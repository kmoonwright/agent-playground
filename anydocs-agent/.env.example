# Copy to .env and fill in. Every value is optional — the agent degrades
# gracefully without any of them (see README).

# Arize AX tracing. Without these, spans go to a local in-process provider
# and the agent still runs (a warning is printed at startup).
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=anydocs-agent

# OpenAI. Without this, embeddings fall back to a deterministic hashed
# pseudo-embedding and the agent's answers fall back to a stub — same span
# shape either way.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
