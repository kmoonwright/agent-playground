# Copy to .env and fill in. Every value is optional -- the agent degrades
# gracefully without any of them (see README).

# Arize AX tracing. Without these, spans go to a local in-process provider
# and the agent still runs (a warning is printed at startup).
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=audio-agent

# OpenAI. Required for real (non-selftest) transcription -- whisper-1 has
# no other provider option here. Also one of the two chat-model choices.
OPENAI_API_KEY=

# Anthropic. Only needed if you pick --model claude-haiku for the
# analyze/respond nodes; transcription always uses OpenAI's Whisper.
ANTHROPIC_API_KEY=

# Max raw audio bytes to base64-attach to the transcribe span (audio.url).
# Above this, the span records why it skipped attaching instead of sending
# a huge data URI.
AUDIO_AGENT_MAX_ATTACH_BYTES=2000000
