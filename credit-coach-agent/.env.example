# OpenAI powers the agent's tool-calling loop and the LLM-judge / agent-judge evaluators.
OPENAI_API_KEY=

# Arize AX space + API key (Space Settings in app.arize.com). Optional for local
# runs -- tracing.py falls back to a local, unexported tracer if these are unset.
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=credit-coach-agent

# Optional: re-skin this demo for a specific customer without touching code.
# COMPANY_NAME=Acme
# AGENT_NAME=Sage
