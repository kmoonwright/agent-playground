# Copy to .env and fill in. Every value is optional — the DJ degrades gracefully.

# Arize AX tracing. Without these, spans go to a local in-process provider
# and the DJ still runs (a warning is printed at startup).
ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=dj-agent

# LLM providers. Provider selection is --provider claude|openai|rule|auto.
# `auto` picks claude if ANTHROPIC_API_KEY is set, else openai, else rule.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model overrides. Resolution order (most specific first):
#   --model-<role> CLI flag > --model CLI flag > DJ_MODEL_<ROLE> > DJ_MODEL > built-in table
DJ_MODEL=
DJ_MODEL_HOST=
DJ_MODEL_CRATE_DIGGER=
DJ_MODEL_TRANSITION_PLANNER=
