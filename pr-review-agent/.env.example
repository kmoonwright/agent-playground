ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=pr-review-agent

# OpenAI (required — this is a real tool-calling loop, not a stub)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

