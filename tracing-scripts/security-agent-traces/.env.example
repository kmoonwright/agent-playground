# Copy to .env and fill in from your Arize space settings.
# Required to export traces. This script does not run without them.

ARIZE_API_KEY=
ARIZE_SPACE_ID=
ARIZE_PROJECT_NAME=security-agent

# Optional
# SESSIONS_PER_SCENARIO=5
# TURNS_PER_SESSION_MIN=2
# TURNS_PER_SESSION_MAX=4
# HOURS_OF_HISTORY=72

# Optional: backfill a fixed historical date range (UTC, inclusive) instead
# of recency-biased "last HOURS_OF_HISTORY hours". Set BOTH or neither.
# BACKDATE_START=2026-09-15
# BACKDATE_END=2026-09-20
